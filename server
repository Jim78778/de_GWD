#!/bin/bash
clear
blue()   { echo -e "\033[34m\033[01m $1 \033[0m"; }
yellow() { echo -e "\033[33m\033[01m $1 \033[0m"; }
green()  { echo -e "\033[32m\033[01m $1 \033[0m"; }
red()    { echo -e "\033[31m\033[01m $1 \033[0m"; }
statuSuccess=$(green "[ OK ]")
statusFailed=$(red "[ failed ]")



branch="master"

# ===== 本仓库地址（不再依赖已失效的上游 jacyl4/de_GWD 与镜像站 gwd.seso.icu）=====
repoOwner="Jim78778"
repoName="de_GWD"
repoRoot="https://raw.githubusercontent.com/${repoOwner}/${repoName}/${branch}"
repoRes="${repoRoot}/resource"
nginxImg="de_gwd/nginx:latest"

installCMD="bash <(wget --no-check-certificate -qO- ${repoRoot}/server)"

mirrorSite="$repoRoot"

# 从本仓库 Dockerfile 本地构建 nginx（替代已失效的 jacyl4/nginx_tls1.3）；
# 构建失败时回退到官方 nginx:stable（同样原生支持 TLS 1.3）。
ensureNginxImage(){
if docker image inspect "$nginxImg" >/dev/null 2>&1; then return 0; fi
mkdir -p /tmp/de_gwd_nginx
if wget --no-check-certificate -q -O /tmp/de_gwd_nginx/Dockerfile "$repoRoot/docker/nginx/Dockerfile" \
   && docker build -t "$nginxImg" /tmp/de_gwd_nginx >/dev/null 2>&1; then
  rm -rf /tmp/de_gwd_nginx
  return 0
fi
yellow "本地构建 nginx 失败，回退使用官方 nginx:stable"
docker pull nginx:stable
nginxImg="nginx:stable"
rm -rf /tmp/de_gwd_nginx
}

# 下载 WebUI 所需的 ui-script / ui-web（GitHub 已移除 SVN 支持，改用 git）。
# 优先 partial clone 仅拉取所需目录（约11MB）；失败则回退整包 tarball。
fetchUI(){
cd ~
rm -rf ~/ui-script ~/ui-web ~/de_GWD_src
if git clone --depth 1 --filter=blob:none --no-checkout \
     "https://github.com/${repoOwner}/${repoName}.git" ~/de_GWD_src >/dev/null 2>&1; then
  cd ~/de_GWD_src
  git config core.sparseCheckout true
  printf 'resource/ui-script/\nresource/ui-web/\n' > .git/info/sparse-checkout
  if git checkout >/dev/null 2>&1; then
    cp -rf resource/ui-script ~/ui-script
    cp -rf resource/ui-web ~/ui-web
  fi
  cd ~
fi
if [[ ! -d ~/ui-web/vendor ]]; then
  rm -rf ~/ui-script ~/ui-web "de_GWD-${branch}"
  wget --no-check-certificate -qO- \
    "https://github.com/${repoOwner}/${repoName}/archive/refs/heads/${branch}.tar.gz" | tar xz
  cp -rf "de_GWD-${branch}/resource/ui-script" ~/ui-script
  cp -rf "de_GWD-${branch}/resource/ui-web" ~/ui-web
  rm -rf "de_GWD-${branch}"
fi
rm -rf ~/de_GWD_src
}



